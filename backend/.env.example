# GitHub personal access tokens, comma-separated.
# Classic PATs use the ghp_ prefix. For public-data GraphQL access, a classic PAT
# should include the public_repo scope. Do not add spaces inside a token.
GITHUB_TOKENS=ghp_your_classic_token_1,ghp_your_classic_token_2
API_HOST=127.0.0.1
API_PORT=8000
MAX_CONCURRENT_PROFILES=8
PROFILE_REQUEST_DELAY_MS=250
REPO_SCAN_LIMIT=100000
DATA_DIR=../data
DB_CSV=../data/db.csv
EXPORTS_DIR=../data/exports
GRAPHQL_POINT_FLOOR=500
ALLOWED_ORIGINS=http://localhost:3000
