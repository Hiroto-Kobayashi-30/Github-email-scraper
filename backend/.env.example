# Comma-separated GitHub PATs. Classic PATs should have read:user and user:email.
GITHUB_TOKENS=ghp_your_token_1,ghp_your_token_2
API_HOST=127.0.0.1
API_PORT=8000
MAX_CONCURRENT_GRAPHQL=4
MAX_CANDIDATE_CONCURRENCY=4
REJECTION_CACHE_TTL_DAYS=30
GRAPHQL_POINTS_PER_MINUTE=1600
GRAPHQL_POINT_FLOOR=500
DATA_DIR=../data
DB_CSV=../data/db.csv
EXPORTS_DIR=../data/exports
ALLOWED_ORIGINS=http://localhost:3000
